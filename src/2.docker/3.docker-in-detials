============================================================
9. BUILD ARGUMENTS - ARG / --build-arg
============================================================

# Dockerfile example:

FROM eclipse-temurin:21-jre

ARG API_VERSION

WORKDIR /app

COPY target/app.jar app.jar

RUN echo "Building API version: ${API_VERSION}"

ENTRYPOINT ["java", "-jar", "app.jar"]

# Pass the build-time variable
docker build \
    --build-arg API_VERSION=2.0 \
    -t my-app:v2.0 \
    .

# Multiple build arguments
docker build \
    --build-arg API_VERSION=2.0 \
    --build-arg ENVIRONMENT=production \
    -t my-app:v2.0 \
    .

# Using a shell variable
export API_VERSION=2.0

docker build \
    --build-arg API_VERSION=$API_VERSION \
    -t my-app:v2.0 \
    .

IMPORTANT:
ARG is primarily for BUILD-TIME configuration.

For runtime configuration, use:
docker run -e VARIABLE=value ...


